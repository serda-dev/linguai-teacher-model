# Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
TEACHER_API_KEY=
# Docker Compose host port (loopback only); Vast external mapped port is different.
TEACHER_HOST_PORT=8000
TEACHER_IMAGE=linguai-teacher:local
# Optional Vast runtime environment; not needed for Compose defaults.
TEACHER_MODEL_DIR=/workspace/models
TEACHER_BIND_HOST=0.0.0.0
# For direct HTTPS, mount both files and set their container paths.
TEACHER_TLS_CERT=
TEACHER_TLS_KEY=
